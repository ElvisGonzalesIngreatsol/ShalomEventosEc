rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Fotos de eventos de la galería
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fotos de portadas del hero y publicidad
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
